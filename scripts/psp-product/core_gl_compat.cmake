# Loaded after the pinned upstream project(), deferred until its targets exist.
# Replace exactly one source compilation unit, not the source checkout.
function(emuorbit_psp_clip_distance_source)
    if(NOT EXISTS "${EMUORBIT_PSP_GL_COMPAT_SOURCE}")
        message(FATAL_ERROR "Exact generated PSP GL compatibility source required")
    endif()
    get_directory_property(emuorbit_targets BUILDSYSTEM_TARGETS)
    set(emuorbit_replacements 0)
    foreach(emuorbit_target IN LISTS emuorbit_targets)
        get_target_property(emuorbit_sources "${emuorbit_target}" SOURCES)
        if(NOT emuorbit_sources)
            continue()
        endif()
        set(emuorbit_changed FALSE)
        set(emuorbit_result "")
        foreach(emuorbit_source IN LISTS emuorbit_sources)
            if(emuorbit_source STREQUAL "GPU/GLES/ShaderManagerGLES.cpp" OR
               emuorbit_source STREQUAL "${CMAKE_CURRENT_SOURCE_DIR}/GPU/GLES/ShaderManagerGLES.cpp")
                list(APPEND emuorbit_result "${EMUORBIT_PSP_GL_COMPAT_SOURCE}")
                math(EXPR emuorbit_replacements "${emuorbit_replacements}+1")
                set(emuorbit_changed TRUE)
            else()
                list(APPEND emuorbit_result "${emuorbit_source}")
            endif()
        endforeach()
        if(emuorbit_changed)
            set_property(TARGET "${emuorbit_target}" PROPERTY SOURCES "${emuorbit_result}")
        endif()
    endforeach()
    if(NOT emuorbit_replacements EQUAL 1)
        message(FATAL_ERROR "PSP GL compatibility must replace exactly one pinned compilation unit")
    endif()
endfunction()
cmake_language(DEFER CALL emuorbit_psp_clip_distance_source)
